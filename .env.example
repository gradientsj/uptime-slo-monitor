# --- Database (Neon / Vercel Postgres / Cloud SQL) ---
# Use the POOLED connection string for serverless (Vercel). Example (Neon):
#   postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Probe trigger auth ---
# Shared secret required to call POST /api/probe (set the same value in the
# GitHub Actions secret CRON_SECRET and in Vercel project env).
CRON_SECRET=change-me-to-a-long-random-string

# --- Config ---
# Path to the services definition file. Defaults to ./services.yaml
SERVICES_CONFIG=services.yaml

# --- Worker (GKE / docker-compose only; ignored on Vercel) ---
# Cron expression for the standalone probe worker. Default: every minute.
PROBE_SCHEDULE=* * * * *
# Days of probe history to retain. Older rows are pruned by the worker.
RETENTION_DAYS=45

# --- Public site ---
NEXT_PUBLIC_SITE_NAME=Uptime & SLO Monitor
NEXT_PUBLIC_OWNER_URL=https://stanleyjacob.dev
